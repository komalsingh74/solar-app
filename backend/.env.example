PORT=4000
MONGO_URI=mongodb://localhost:27017/solar-panel-management
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Set true after configuring user permissions to enforce master record access.
MASTER_PERMISSIONS_ENABLED=false
TELEPHONY_ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-64-character-hex-key
